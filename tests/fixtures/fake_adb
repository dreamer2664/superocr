#!/usr/bin/env python3
"""fake adb — emulates just enough of the real thing for tests.

State lives in $FAKE_ADB_STATE:
    calls.log  every call (screencap / dump / tap X Y / text …)
    ui.xml     last dumped hierarchy
    typed.txt  what `input text` received (decoded), echoed into the next dump
Env switches:
    FAKE_ADB_MODE=device|unauthorized|none|two
    FAKE_ADB_XML=default|webview|empty
    FAKE_ADB_BAD_VERIFY=1     (the field never shows the typed text)
    FAKE_ADB_FAIL_SCREENCAP=1
"""
import io
import os
import sys
from pathlib import Path

STATE = Path(os.environ.get("FAKE_ADB_STATE", "/tmp/fake_adb_state"))
STATE.mkdir(parents=True, exist_ok=True)


def out(text: str) -> int:
    sys.stdout.write(text)
    return 0


def log(line: str) -> None:
    with (STATE / "calls.log").open("a") as f:
        f.write(line + "\n")


def screen_png() -> bytes:
    from PIL import Image, ImageDraw
    im = Image.new("RGB", (1080, 2400), "white")
    d = ImageDraw.Draw(im)
    d.rectangle([100, 400, 880, 700], fill=(30, 60, 120))
    d.text((130, 530), "CAPTCHA", fill="white")
    buf = io.BytesIO()
    im.save(buf, "PNG")
    return buf.getvalue()


def typed_value() -> str:
    p = STATE / "typed.txt"
    if os.environ.get("FAKE_ADB_BAD_VERIFY") == "1":
        return ""
    return p.read_text().strip() if p.is_file() else ""


def hierarchy() -> str:
    variant = os.environ.get("FAKE_ADB_XML", "default")
    if variant == "webview":
        return ('<hierarchy rotation="0">'
                '<node class="android.widget.FrameLayout" bounds="[0,0][1080,2400]">'
                '<node class="android.webkit.WebView" bounds="[0,200][1080,1600]">'
                '<node class="android.view.View" bounds="[200,400][800,700]"/>'
                '</node></node></hierarchy>')
    if variant == "empty":
        return ('<hierarchy rotation="0">'
                '<node class="android.widget.FrameLayout" bounds="[0,0][1080,2400]">'
                '<node class="android.widget.TextView" text="Hello there" '
                'bounds="[0,0][300,100]"/></node></hierarchy>')
    return ('<hierarchy rotation="0">'
            '<node class="android.widget.FrameLayout" bounds="[0,0][1080,2400]">'
            '<node class="android.widget.ImageView" '
            'resource-id="com.example.app:id/captcha_image" text="" '
            'bounds="[100,400][880,700]"/>'
            '<node class="android.widget.EditText" '
            'resource-id="com.example.app:id/captcha_input" '
            f'text="{typed_value()}" focusable="true" clickable="true" '
            'bounds="[100,760][880,860]"/>'
            '<node class="android.widget.Button" text="Verify" clickable="true" '
            'bounds="[100,900][880,1000]"/>'
            '</node></hierarchy>')


def main() -> int:
    args = sys.argv[1:]
    mode = os.environ.get("FAKE_ADB_MODE", "device")

    if args[:1] == ["version"]:
        return out("Android Debug Bridge version 1.0.41\n")
    if "-s" in args:
        i = args.index("-s")
        args = args[:i] + args[i + 2:]
    if args[:1] == ["devices"]:
        if mode == "none":
            return out("List of devices attached\n\n")
        if mode == "unauthorized":
            return out("List of devices attached\nFAKE12345678\tunauthorized\n")
        if mode == "two":
            return out("List of devices attached\nFAKE12345678\tdevice\n"
                       "FAKE87654321\tdevice\n")
        return out("List of devices attached\nFAKE12345678\tdevice\n")
    if args[:2] == ["exec-out", "screencap"]:
        if os.environ.get("FAKE_ADB_FAIL_SCREENCAP") == "1":
            sys.stderr.write("error: device offline\n")
            return 1
        log("screencap")
        sys.stdout.buffer.write(screen_png())
        return 0
    if args[:2] == ["exec-out", "cat"]:
        log("cat " + (args[2] if len(args) > 2 else ""))
        return out(hierarchy())
    if args[:4] == ["exec-out", "uiautomator", "dump", "/dev/tty"]:
        log("dump-tty")
        return out(hierarchy())
    if args[:3] == ["shell", "uiautomator", "dump"]:
        log("dump " + (args[3] if len(args) > 3 else ""))
        (STATE / "ui.xml").write_text(hierarchy())
        return out("UI hierchary dumped to: /sdcard/qcaptcha_ui.xml\n")
    if args[:3] == ["shell", "input", "tap"]:
        log(f"tap {args[3]} {args[4]}")
        return 0
    if args[:3] == ["shell", "input", "text"]:
        raw = args[3]
        log("text " + raw)
        txt = raw
        if txt.startswith("'") and txt.endswith("'") and len(txt) > 1:
            txt = txt[1:-1]
        txt = txt.replace("%s", " ").replace("'\\''", "'")
        (STATE / "typed.txt").write_text(txt)
        return 0
    if args[:3] == ["shell", "sh", "-c"]:
        cmd = args[3]
        if "ime list" in cmd:
            return out("")
        if "dumpsys window" in cmd:
            return out("mCurrentFocus=Window{1 u0 com.example.app/"
                       "com.example.app.MainActivity}\n")
        return out("")
    if args[:2] == ["shell", "getprop"]:
        props = {"ro.build.version.release": "13",
                 "ro.product.model": "Pixel 8 (fake)"}
        return out(props.get(args[2], "") + "\n")
    if args[:3] == ["shell", "wm", "size"]:
        return out("Physical size: 1080x2400\n")
    if args[:2] == ["shell", "am"]:
        log("am " + " ".join(args[2:]))
        return out("Broadcasting: Intent\n")
    sys.stderr.write("fake-adb: unhandled: " + " ".join(args) + "\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
